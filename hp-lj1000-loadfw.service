[Unit]
Description=Upload HP LaserJet 1000 host-based firmware over USB
Documentation=https://github.com/yfozekosh/hp-laserjet1000-fedora
# Do not fight the boot process if the printer is not plugged in.
ConditionPathExists=/sys/bus/usb/devices
After=multi-user.target

[Service]
Type=oneshot
# udev fires as soon as the device enumerates; give it a moment to settle.
ExecStartPre=/bin/sleep 3
ExecStart=/usr/local/sbin/hp-lj1000-loadfw
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
